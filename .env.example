# ==============================================================================
# The Lenny Growth Assistant - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env) to configure local development settings.
# All sensitive values are placeholder defaults.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Backend Server Configuration
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://localhost:8081"]

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_LOCAL_MODELS=true

# Database Configuration (PostgreSQL with pgvector)
# Note: If PostgreSQL is not running, the application will automatically fall back
# to a local SQLite database (sqlite:///./lenny_assistant.db) during development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=lenny_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres_password_placeholder@localhost:5432/lenny_assistant
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres_password_placeholder@localhost:5432/lenny_assistant_test

# Local LLM Inference (Ollama)
# Supported verified models: qwen3:4b, llama3:latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
DEFAULT_LLM_PROVIDER=local

# Cloud LLM Inference (OpenRouter)
# Required when using Cloud Provider mode
OPENROUTER_API_KEY=your_openrouter_api_key_placeholder
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Generation Limits & Timeouts
CHAT_MAX_TOKENS=2048
ESSAY_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# Legacy Anthropic Provider (Optional fallback)
# ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder
# ANTHROPIC_MODEL_NAME=claude-3-haiku-20240307
